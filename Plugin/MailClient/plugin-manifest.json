{"manifestVersion":"1.0.0","name":"MailClient","version":"1.0.0","displayName":"邮件客户端","description":"IMAP收邮件+SMTP发邮件的全功能邮件客户端插件","author":"Rosa","pluginType":"synchronous","entryPoint":{"type":"nodejs","command":"node MailClient.js"},"communication":{"protocol":"stdio","timeout":30000},"configSchema":{"IMAP_HOST":{"type":"string","description":"IMAP服务器地址","default":"imap.163.com"},"IMAP_PORT":{"type":"number","description":"IMAP端口","default":993},"SMTP_HOST":{"type":"string","description":"SMTP服务器地址","default":"smtp.163.com"},"SMTP_PORT":{"type":"number","description":"SMTP端口","default":465},"EMAIL_ADDRESS":{"type":"string","description":"邮箱地址"},"EMAIL_AUTH_CODE":{"type":"string","description":"邮箱授权码"},"EMAIL_SENDER_NAME":{"type":"string","description":"发件人显示名称","default":"Rosa"}},"capabilities":{"invocationCommands":[{"commandIdentifier":"ListMails","description":"列出收件箱邮件列表。参数: folder(可选,默认INBOX), limit(可选,默认20), page(可选,默认1)"},{"commandIdentifier":"ReadMail","description":"读取指定邮件完整内容。参数: uid(必需), folder(可选,默认INBOX)"},{"commandIdentifier":"SendMail","description":"发送邮件。参数: to(必需), subject(必需), body(必需), cc(可选), bcc(可选), isHtml(可选,默认false)"},{"commandIdentifier":"SearchMails","description":"搜索邮件。参数: query(必需), folder(可选), searchIn(可选,subject/from/to/body/all), limit(可选)"},{"commandIdentifier":"ListFolders","description":"列出邮箱所有文件夹"},{"commandIdentifier":"DeleteMail","description":"删除邮件。参数: uid(必需), folder(可选,默认INBOX)"}]}}