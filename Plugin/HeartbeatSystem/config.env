# ============================================================
# HeartbeatSystem 配置文件
# 修改后立即生效（热加载），无需重启VCP
# ============================================================

# ==================== 时间段配置（热加载 + 分钟级支持） ====================
# 格式: TIME_SLOT_N=名称:HH:MM-HH:MM
# 使用24小时制，支持跨午夜配置
# 可以自定义时段数量和划分方式

TIME_SLOT_1=凌晨:00:00-06:00
TIME_SLOT_2=上午:06:00-12:00
TIME_SLOT_3=下午:12:00-18:00
TIME_SLOT_4=晚上:18:00-24:00

# -------------------- 配置示例 --------------------

# 示例1：三个时段
# TIME_SLOT_1=上午:06:00-12:00
# TIME_SLOT_2=下午:12:00-18:00
# TIME_SLOT_3=晚上:18:00-24:00

# 示例2：更精细的六时段
# TIME_SLOT_1=深夜:00:00-05:00
# TIME_SLOT_2=早晨:05:00-09:00
# TIME_SLOT_3=上午:09:00-12:00
# TIME_SLOT_4=下午:12:00-17:00
# TIME_SLOT_5=傍晚:17:00-20:00
# TIME_SLOT_6=晚上:20:00-24:00

# 示例3：跨午夜时段（夜猫子模式）
# TIME_SLOT_1=深夜:00:00-03:00
# TIME_SLOT_2=上午:09:00-12:00
# TIME_SLOT_3=下午:12:00-18:00
# TIME_SLOT_4=晚间:18:00-24:00

# 示例4：精确到分钟
# TIME_SLOT_1=早班:08:30-12:30
# TIME_SLOT_2=午休:12:30-14:00
# TIME_SLOT_3=下午:14:00-18:30
# TIME_SLOT_4=晚间:18:30-23:00

# ==================== 活动时间窗口（支持跨午夜） ====================

# Agent活动开始时间（24小时制）
# 在此时间之前不会触发心跳
START_HOUR=12

# Agent活动结束时间（24小时制）
# 支持跨午夜：如 START_HOUR=12, END_HOUR=3 表示中午12点到凌晨3点
END_HOUR=3

# ==================== 心跳间隔配置 ====================

# 有待办任务时的最小间隔（分钟）
MIN_INTERVAL_WITH_TASKS=20

# 有待办任务时的最大间隔（分钟）
MAX_INTERVAL_WITH_TASKS=40

# 无待办任务时的最小间隔（分钟）
MIN_INTERVAL_NO_TASKS=30

# 无待办任务时的最大间隔（分钟）
MAX_INTERVAL_NO_TASKS=60

# ==================== 提示词模板配置 ====================

# 凌晨时段首次规划模板
PROMPT_TEMPLATE_PLANNING_DAWN=heartbeat_planning_dawn

# 上午时段首次规划模板
PROMPT_TEMPLATE_PLANNING_MORNING=heartbeat_planning_morning

# 下午时段首次规划模板
PROMPT_TEMPLATE_PLANNING_AFTERNOON=heartbeat_planning_afternoon

# 晚上时段首次规划模板
PROMPT_TEMPLATE_PLANNING_EVENING=heartbeat_planning_evening

# 常规心跳模板（非首次规划时使用）
PROMPT_TEMPLATE_ROUTINE=heartbeat_routine

# ==================== fixed任务投递 timed-contact（方案B） ====================
# 开启后，AddTask(type=fixed) 会为每条任务创建一个 timed-contact 文件（VCPTimedContacts），到点唤醒执行
# 同步模型：schedule.json 为源数据；timed-contact 为投递物；执行后需要 AgentAssistant 调用 UpdateTaskStatus 回写状态（弱一致）
ENABLE_FIXED_TASK_TIMEDCONTACT=true

# 提前唤醒分钟数：例如 1 表示在任务计划时间前1分钟唤醒（避免执行链路延迟导致错过整点）
FIXED_TASK_LEAD_MINUTES=0

# ==================== 调试配置 ====================

# 是否启用调试日志
HEARTBEAT_DEBUG=true