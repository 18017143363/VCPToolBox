# ============================================================
# HeartbeatSystem 配置文件
# 复制此文件为 config.env 并根据需要修改
# ============================================================

# ==================== 基础配置 ====================

# 启用的Agent列表（逗号分隔）
# 留空则自动扫描 AgentSchedules 目录下的所有Agent
# 示例: ENABLED_AGENTS=Rosa,小元,小娜
ENABLED_AGENTS=

# 日程文件存储目录（相对于VCP根目录）
# 默认: AgentSchedules
SCHEDULES_DIR=AgentSchedules

# 定时任务文件目录（相对于VCP根目录）
# 心跳触发会在此目录创建任务文件，由VCP定时扫描器执行
# 默认: VCPTimedContacts
TIMED_CONTACTS_DIR=VCPTimedContacts

# ==================== 活动时间窗口 ====================

# Agent活动开始时间（24小时制）
# 在此时间之前不会触发心跳
# 默认: 8
START_HOUR=8

# Agent活动结束时间（24小时制）
# 在此时间之后不会触发心跳，等待第二天START_HOUR
# 默认: 23
END_HOUR=23

# ==================== 心跳间隔配置 ====================

# 有待办任务时的最小间隔（分钟）
# 默认: 20
MIN_INTERVAL_WITH_TASKS=20

# 有待办任务时的最大间隔（分钟）
# 默认: 40
MAX_INTERVAL_WITH_TASKS=40

# 无待办任务时的最小间隔（分钟）
# 默认: 30
MIN_INTERVAL_NO_TASKS=30

# 无待办任务时的最大间隔（分钟）
# 默认: 60
MAX_INTERVAL_NO_TASKS=60

# ==================== 提示词模板配置 ====================
# 
# HeartbeatSystem 支持多模板机制：
# - 每个时段的首次规划使用独立的模板
# - 常规心跳（非首次规划）使用统一的routine模板
#
# 模板文件放置在插件目录下，扩展名为 .txt
# 例如: heartbeat_planning_dawn.txt
#
# 四个时段划分：
# - 凌晨: 0:00 - 6:00
# - 上午: 6:00 - 12:00
# - 下午: 12:00 - 18:00
# - 晚上: 18:00 - 24:00
# ==================== 

# 凌晨时段(0-6点)首次规划模板
# 默认: heartbeat_planning_dawn
PROMPT_TEMPLATE_PLANNING_DAWN=heartbeat_planning_dawn

# 上午时段(6-12点)首次规划模板
# 默认: heartbeat_planning_morning
PROMPT_TEMPLATE_PLANNING_MORNING=heartbeat_planning_morning

# 下午时段(12-18点)首次规划模板
# 默认: heartbeat_planning_afternoon
PROMPT_TEMPLATE_PLANNING_AFTERNOON=heartbeat_planning_afternoon

# 晚上时段(18-24点)首次规划模板
# 默认: heartbeat_planning_evening
PROMPT_TEMPLATE_PLANNING_EVENING=heartbeat_planning_evening

# 常规心跳模板（非首次规划时使用）
# 默认: heartbeat_routine
PROMPT_TEMPLATE_ROUTINE=heartbeat_routine

# ==================== 旧版兼容 ====================
# 如果只想使用单一模板（不区分时段），可以设置此项
# 设置后会覆盖上面的多模板配置
# 留空则使用多模板机制
# PROMPT_TEMPLATE_NAME=heartbeat_prompt