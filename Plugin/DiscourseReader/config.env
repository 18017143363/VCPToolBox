# DiscourseReader Configuration
# ============================================================

# Default Discourse forum URL
DISCOURSE_BASE_URL=https://linux.do

# Default category slug for ListTopics (when no category specified)
DEFAULT_CATEGORY=develop

# Max characters per post content (longer content will be truncated)
MAX_CONTENT_LENGTH=3000

# Max posts to return in ReadTopic
MAX_POSTS=10

# ============================================================
# Authentication (Multi-Forum Support)
# ============================================================
# User API Key (recommended, permanent, obtained via RSA handshake)
# Format: forum_{name}_api_key=<key>
# The {name} is matched against the forum's hostname.
# Example: forum_linuxdo_api_key matches *.linux.do
#
# To obtain a User API Key, run:
#   python get_user_api_key.py https://linux.do
# Then follow the instructions.
#
forum_linuxdo_api_key=4996153ee3be11c617abaf227d5c20b5
forum_linuxdo_client_id=CnTRAEh_Y48ZCZyQuFp2641Aq_vllv13o0rVJZ7w5BE
# forum_metacommunity_api_key=another_key_here

# ============================================================
# Cookie Authentication (fallback, less reliable)
# ============================================================
# Raw cookie string from browser (session-based, may expire)
# API Key is preferred over cookies when both are configured.
# Format: forum_{name}_cookie=<raw_cookie_string>
#
# forum_linuxdo_cookie=_t=xxx; _forum_session=xxx# Docker Forum
forum_forumsdockercom_api_key=89c56b424fbf9f2290afb8b7781bdf48