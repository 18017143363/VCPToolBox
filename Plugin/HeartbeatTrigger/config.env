# HeartbeatTrigger 配置文件 v2.0
# 智能随机调度系统

# ===== 基础配置 =====
# 启用心跳的Agent列表（逗号分隔）
ENABLED_AGENTS=Rosa

# 心跳活动时间范围（24小时制）
START_HOUR=8
END_HOUR=23

# ===== 智能调度配置 =====
# 是否启用启动规划（VCP启动时触发）
ENABLE_STARTUP_PLANNING=false

# 时段规划触发时间（逗号分隔，24小时制）
# 每个时段开始时触发规划提示
PERIOD_PLANNING_HOURS=0,6,12,18

# ===== 动态心跳间隔配置 =====
# 有未完成任务时的心跳间隔范围（分钟）
HEARTBEAT_MIN_PENDING=20
HEARTBEAT_MAX_PENDING=40

# 全部任务完成时的心跳间隔范围（分钟）
HEARTBEAT_MIN_COMPLETED=30
HEARTBEAT_MAX_COMPLETED=60

# ===== 目录配置 =====
SCHEDULES_DIR=AgentSchedules
TIMED_CONTACTS_DIR=VCPTimedContacts

# ===== 提示词模板 =====
# 请直接编辑以下文件：
# - period_planning_prompt.txt  (时段规划提示词)
# - heartbeat_prompt.txt (心跳检查提示词)