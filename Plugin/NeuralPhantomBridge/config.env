# NeuralPhantomBridge config
# NP side chrome.storage.local.vcpAuthToken must match this value.
NP_AUTH_TOKEN=np_bridge_secret_token_change_me

# Independent WebSocket server port. NP connects to ws://localhost:6016/np-bridge
NP_WS_PORT=6016
NP_WS_PATH=/np-bridge

# TrafficStore cache limits
NP_MAX_REQUESTS=1000
NP_MAX_ALERTS=200
NP_MAX_CRYPTO_EVENTS=500
NP_MAX_WS_FRAMES=500

# Max pushed body preview chars
NP_MAX_BODY_PREVIEW=2000